<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /cybersentinel/

  # Proxy WebSocket /api/ws
  RewriteCond %{HTTP:Upgrade} websocket [NC]
  RewriteCond %{HTTP:Connection} upgrade [NC]
  RewriteRule ^api/ws/?(.*)$ ws://127.0.0.1:8000/api/ws$1 [P,L]

  # Proxy API calls to FastAPI backend
  RewriteRule ^api/(.*)$ http://127.0.0.1:8000/api/$1 [P,L]

  # Route SPA front-end paths to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /cybersentinel/index.html [L]
</IfModule>
